---
// Pinned nav (Figma "nav" 2060:942) and the mobile menu sheet (2104:2626).
// Links are plain fragment links: on the home page the browser smooth-scrolls (see global.css),
// elsewhere they load the home page at that section.
import MenuIcon from '../icons/menu.svg';
import CloseIcon from '../icons/close.svg';
import { profile } from '../lib/content';

interface Props {
  showThoughts: boolean;
}
const { showThoughts } = Astro.props;

const items = [
  { label: 'Work', href: '/#work' },
  { label: 'Experience', href: '/#experience' },
  { label: 'About', href: '/#about' },
  ...(showThoughts ? [{ label: 'Thoughts', href: '/#thoughts' }] : []),
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">SEAN KIM</a>

    <nav class="links" aria-label="Main">
      <ul>
        {items.map((it) => <li><a href={it.href}>{it.label}</a></li>)}
        <li>
          <a href={profile.resume} target="_blank" rel="noopener">Résumé <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (PDF, opens in a new tab)</span></a>
        </li>
      </ul>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-sheet">
      <span class="menu-label">Menu</span>
      <MenuIcon class="icon-menu" aria-hidden="true" />
      <CloseIcon class="icon-close" aria-hidden="true" />
    </button>
  </div>
</header>

<div id="menu-sheet" class="sheet" hidden>
  <nav aria-label="Main menu">
    <ul>
      {items.map((it, i) => (
        <li><a href={it.href}><span class="num">{String(i + 1).padStart(2, '0')}</span>{it.label}</a></li>
      ))}
      <li>
        <a href={profile.resume} target="_blank" rel="noopener"><span class="num" aria-hidden="true">↗</span>Résumé<span class="visually-hidden"> (PDF, opens in a new tab)</span></a>
      </li>
    </ul>
  </nav>
  <a class="sheet-email" href={`mailto:${profile.email}`}>{profile.email}</a>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const sheet = document.getElementById('menu-sheet')!;
  const label = btn.querySelector('.menu-label')!;
  const isOpen = () => btn.getAttribute('aria-expanded') === 'true';

  const set = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Close' : 'Menu';
    sheet.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open); // scroll lock
  };

  btn.addEventListener('click', () => set(!isOpen()));
  // Close first, so the fragment navigation that follows can scroll the page.
  sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));

  document.addEventListener('keydown', (e) => {
    if (!isOpen()) return;
    if (e.key === 'Escape') {
      set(false);
      btn.focus();
    } else if (e.key === 'Tab') {
      // Focus trap: the toggle button plus the sheet's links.
      const items = [btn, ...sheet.querySelectorAll<HTMLElement>('a')];
      const i = items.indexOf(document.activeElement as HTMLElement);
      const next = e.shiftKey ? (i <= 0 ? items.length - 1 : i - 1) : (i === items.length - 1 ? 0 : i + 1);
      e.preventDefault();
      items[next].focus();
    }
  });

  matchMedia('(min-width: 768px)').addEventListener('change', (e) => e.matches && set(false));
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: color-mix(in srgb, var(--silver-50) 94%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(var(--nav-h) - 1px);
  }
  .brand {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 18px;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
  .links ul {
    display: flex;
    align-items: baseline;
    gap: 32px;
  }
  .links a {
    font-weight: 500;
    font-size: 15px;
    color: var(--ink);
  }
  /* The mono arrow must not change the line box, or Résumé sits lower than the rest. */
  .arrow { font-family: var(--font-mono); font-weight: 400; line-height: 0; }

  .menu-btn {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    border: 0;
    background: none;
    font-weight: 500;
    font-size: 15px;
    color: var(--ink);
    cursor: pointer;
  }
  .menu-btn[aria-expanded='true'] .icon-menu,
  .menu-btn[aria-expanded='false'] .icon-close { display: none; }

  .sheet {
    position: fixed;
    inset: 0;
    z-index: 49;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--nav-h) + 32px) var(--gutter) 40px;
    background: var(--silver-50);
    overflow-y: auto;
  }
  .sheet[hidden] { display: none; }
  .sheet ul { border-top: 1px solid var(--silver-200); }
  .sheet li { border-bottom: 1px solid var(--silver-200); }
  .sheet li a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-block: 20px;
    font-weight: 800;
    font-size: 30px;
    line-height: 1.05;
    color: var(--ink);
  }
  .num {
    flex: 0 0 24px;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 13px;
    color: var(--muted);
  }
  .sheet-email {
    margin-top: 40px;
    font-weight: 800;
    font-size: 20px;
    color: var(--ink);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .links { display: none; }
    .menu-btn { display: flex; }
  }
</style>
