---
// Bag artwork from the Figma "Luggage" component (29:591), 220×300 frame.
import Suitcase from '../icons/bags/suitcase.svg';
import Duffel from '../icons/bags/duffel.svg';
import Backpack from '../icons/bags/backpack.svg';
import Briefcase from '../icons/bags/briefcase.svg';

interface Props {
  type: 'suitcase' | 'duffel' | 'backpack' | 'briefcase';
  tag: string;
}
const { type, tag } = Astro.props;
const Art = { suitcase: Suitcase, duffel: Duffel, backpack: Backpack, briefcase: Briefcase }[type];
// Top-left of the luggage tag before its 8° tilt, per bag.
const [x, y] = { suitcase: [134, 242], duffel: [148, 242], backpack: [136, 152], briefcase: [156, 242] }[type];
---

<span class="bag" aria-hidden="true">
  <Art class="art" />
  <span class="tag" style={`left:${x}px;top:${y}px`}>{tag}</span>
</span>

<style>
  .bag {
    position: absolute;
    inset: 0;
    transition: transform 350ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .art { position: absolute; inset: 0; }
  .tag {
    position: absolute;
    width: 34px;
    height: 22px;
    display: grid;
    place-items: center;
    background: var(--white);
    border: 1px solid var(--ink);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 11px;
    line-height: 1;
    color: var(--ink);
    transform: rotate(8deg);
  }
</style>
