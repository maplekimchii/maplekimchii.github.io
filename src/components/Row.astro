---
// Project / post row (Figma "project-row", "post-row"). The whole row is the link.
interface Props {
  code: string;
  title: string;
  text: string;
  tag: string;
  href?: string;
}
const { code, title, text, tag, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="row" href={href}>
  <span class="code">{code}</span>
  <span class="body">
    <h3 class="title">{title}</h3>
    <span class="text">{text}</span>
  </span>
  <span class="tag">{tag}</span>
  <span class="arrow" aria-hidden="true">→</span>
</Tag>

<style>
  .row {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) auto 22px;
    grid-template-areas: 'code body tag arrow';
    align-items: start;
    gap: 40px;
    padding-block: 28px;
    color: var(--ink);
  }
  a.row:hover { text-decoration: none; }
  a.row:hover .title { text-decoration: underline; text-underline-offset: 4px; }
  .code {
    grid-area: code;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .body {
    grid-area: body;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .title { font-weight: 700; font-size: 26px; line-height: normal; }
  .text { max-width: 640px; font-size: 16px; line-height: 1.5; color: var(--muted); }
  .tag {
    grid-area: tag;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .arrow { grid-area: arrow; font-size: 22px; line-height: normal; }

  @media (max-width: 767px) {
    .row {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'code tag' 'body body';
      gap: 8px;
      padding-block: 20px;
    }
    .title { font-size: 22px; }
    .text { font-size: 15px; }
    .arrow { display: none; }
  }
</style>
