---
import FlapTile from './FlapTile.astro';

interface Props {
  rows: string[]; // each row padded to the same length; spaces are blank tiles
}
const { rows } = Astro.props;
---

<div class="split-flap" aria-hidden="true">
  {rows.map((row) => (
    <div class="flap-row">
      {[...row].map((c) => <FlapTile char={c} />)}
    </div>
  ))}
</div>

<script>
  // Flip-in on load: each tile cycles random characters, fast at first, then slows (ease-out)
  // onto its letter. About 2s total. Clicking a tile "ruffles" it: a shorter shuffle plus a wobble.
  const tiles = document.querySelectorAll<HTMLElement>('.split-flap .flap');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
  const busy = new WeakSet<HTMLElement>();

  const shuffle = (tile: HTMLElement, cycles: number, delay = 0) => {
    const el = tile.querySelector<HTMLElement>('.char');
    const final = tile.dataset.char ?? '';
    if (!el || busy.has(tile)) return;
    busy.add(tile);
    let n = 0;
    const step = () => {
      n += 1;
      el.textContent = n >= cycles ? final : glyphs[Math.floor(Math.random() * glyphs.length)];
      // 35ms per flip at the start, easing up to ~215ms for the last ones.
      if (n < cycles) setTimeout(step, 35 + 180 * (n / cycles) ** 3);
      else busy.delete(tile);
    };
    setTimeout(step, delay);
  };

  if (!reduce) {
    tiles.forEach((tile, i) => {
      if (tile.dataset.char !== ' ') shuffle(tile, 20, i * 40);
      tile.addEventListener('click', () => {
        if (busy.has(tile)) return;
        tile.classList.remove('ruffle');
        void tile.offsetWidth; // restart the wobble animation
        tile.classList.add('ruffle');
        shuffle(tile, 12);
      });
    });
  }
</script>

<style>
  .split-flap {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .flap-row {
    display: flex;
    gap: 8px;
  }
</style>
