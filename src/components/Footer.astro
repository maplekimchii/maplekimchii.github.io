---
import { profile } from '../lib/content';
---

<footer class="container site-footer">
  <p class="label">Say hello</p>
  <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
  <div class="row">
    <p>© 2026 {profile.name}</p>
    <p>Thanks for flying by.</p>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 56px;
    padding-top: 100px;
    padding-bottom: 56px;
  }
  .label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .email {
    font-weight: 800;
    font-size: 56px;
    line-height: normal;
    color: var(--ink);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }
  .row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 767px) {
    .site-footer { gap: 32px; padding-top: 72px; }
    .email { font-size: 28px; }
  }
</style>
