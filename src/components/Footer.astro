---
import { profile } from '../lib/content';
---

<footer class="container site-footer">
  <div class="hello">
    <p class="label">Let’s keep in touch!</p>
    <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
  </div>
  <div class="row">
    <p>© 2026 {profile.name}</p>
    <p>Thanks for flying by.</p>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 48px;
    padding-top: 40px;
    padding-bottom: 56px;
  }
  .hello { display: flex; flex-direction: column; gap: 8px; }
  .label {
    font-weight: 800;
    font-size: 28px;
    line-height: normal;
  }
  .email {
    font-weight: 500;
    font-size: 18px;
    line-height: normal;
    color: var(--ink);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }
  .row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 767px) {
    .site-footer { gap: 32px; padding-top: 32px; }
    .label { font-size: 22px; }
    .email { font-size: 16px; }
  }
</style>
