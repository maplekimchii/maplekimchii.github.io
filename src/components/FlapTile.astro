---
interface Props {
  char: string; // use ' ' for an empty flap
}
const { char } = Astro.props;
---

<span class="flap" data-char={char}><span class="char">{char === ' ' ? ' ' : char}</span></span>

<style>
  .flap {
    /* 79.2×108 in Figma; shrinks only when four tiles don't fit (narrow phones) */
    --w: min(79.2px, (100vw - 2 * var(--gutter) - 24px) / 4);
    position: relative;
    display: grid;
    place-items: center;
    width: var(--w);
    aspect-ratio: 88 / 120;
    border-radius: 6px;
    overflow: hidden;
    background: linear-gradient(var(--ink) 0 49.17%, var(--silver-50) 49.17% 50.83%, var(--ink) 50.83%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .flap { cursor: pointer; }
  }
  .flap.ruffle { animation: ruffle 600ms cubic-bezier(0.3, 0.7, 0.4, 1); }
  @keyframes ruffle {
    0% { transform: none; }
    20% { transform: perspective(300px) rotateX(-28deg) rotate(-3deg); }
    45% { transform: perspective(300px) rotateX(18deg) rotate(2deg); }
    70% { transform: perspective(300px) rotateX(-8deg) rotate(-1deg); }
    100% { transform: none; }
  }
  .char {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: calc(var(--w) * 84 / 88);
    line-height: 1;
    color: var(--flap-yellow);
  }
</style>
