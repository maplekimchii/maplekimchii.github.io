---
// Figma "Journey Map / Compact" (2077:1409): 480×196 map viewport above a 64px slider bar.
import { Picture } from 'astro:assets';
import basemap from '../assets/inflight-basemap.png';
import { getCities } from '../lib/content';
import { VIEW_H, W, ZOOM, cameraAt, heading, legSamples, pathD, project, toScreen } from '../lib/journey';

const cities = (await getCities()).map((c) => ({ code: c.id, ...c.data }));
const legs = cities.slice(0, -1).map((_, i) => legSamples(cities, i));
const total = cities.at(-1)!.km;
const last = cities.length;

// Server-rendered state: step 1 (Seoul). The client takes over from here.
const cam = cameraAt(project(cities[0]));
const pts = cities.map((c) => toScreen(project(c), cam));
const pct = ([x, y]: [number, number]) => `left:${(x / W) * 100}%;top:${(y / VIEW_H) * 100}%`;
const stopPct = (km: number) => (km / total) * 100;
const worldTransform = `translate(${(cam.tx / W) * 100}%, ${(cam.ty / 520) * 100}%) scale(${cam.s})`;
---

<figure class="journey" data-journey={JSON.stringify(cities)} style={`--zoom:${ZOOM}`}>
  <div class="stage">
    <div class="world" style={`transform:${worldTransform}`}>
      <Picture
        src={basemap}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[2560]}
        sizes="2560px"
        alt=""
        loading="lazy"
        decoding="async"
        class="basemap"
      />
      <svg class="routes" viewBox={`0 0 ${W} 520`} preserveAspectRatio="none" aria-hidden="true">
        {legs.map((leg, i) => <path d={pathD(leg)} data-leg={i} style="opacity:0" />)}
      </svg>
    </div>

    <div class="markers" aria-hidden="true">
      {cities.map((c, i) => (
        <>
          <span class:list={['pin', { current: i === 0 }]} data-pin={i} style={pct(pts[i])}></span>
          <span class:list={['label', `at-${c.label}`, { current: i === 0 }]} data-label={i} style={pct(pts[i])}>{c.city}</span>
        </>
      ))}
      <img
        class="plane"
        src="/img/aircraft-top.svg"
        alt=""
        width="62"
        height="58"
        style={`${pct(pts[0])};--rot:${heading(legs[0][0], legs[0][1])}deg`}
      />
    </div>
  </div>

  <div class="hud">
    <div
      class="track"
      role="slider"
      tabindex="0"
      aria-label="Journey stop"
      aria-valuemin={1}
      aria-valuemax={last}
      aria-valuenow={1}
      aria-valuetext={`${cities[0].city}, 0 km`}
    >
      <span class="rail"></span>
      <span class="progress" style="width:0%"></span>
      {cities.map((c, i) => (
        <span class:list={['stop', { current: i === 0 }]} data-stop={i} style={`left:${stopPct(c.km)}%`}>
          <span class="code">{c.code}</span>
        </span>
      ))}
      <img class="thumb" src="/img/aircraft-side.svg" alt="" width="67" height="23" style="left:0%" />
    </div>
  </div>

  <figcaption class="visually-hidden">
    Cities I’ve lived in, in order:
    <ol>
      {cities.map((c) => <li>{c.city}, {c.country}</li>)}
    </ol>
    Imagery: NASA Blue Marble. Borders: Natural Earth.
  </figcaption>
  <p class="visually-hidden" aria-live="polite" data-live></p>
</figure>

<script>
  import { initJourney } from '../lib/journey-client';
  document.querySelectorAll<HTMLElement>('.journey').forEach(initJourney);
</script>

<style>
  .journey { background: var(--ink); }
  .stage {
    position: relative;
    aspect-ratio: 480 / 196;
    overflow: hidden;
  }
  .world {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    aspect-ratio: 1280 / 520;
    transform-origin: 0 0;
    will-change: transform;
  }
  .world :global(.basemap),
  .world :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .world :global(img.basemap) { object-fit: cover; }
  .routes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .routes path {
    fill: none;
    stroke: var(--sky-blue);
    /* non-scaling-stroke undoes the viewBox scale but not the world's CSS zoom: 3px on screen */
    stroke-width: calc(3px / var(--zoom));
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* Pins and labels keep a constant on-screen size while the map zooms. */
  .markers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .pin {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--white);
    border: 1.5px solid var(--ink);
    transform: translate(-50%, -50%);
  }
  .pin.current {
    width: 14px;
    height: 14px;
    background: var(--flap-yellow);
  }
  .label {
    position: absolute;
    font-weight: 700;
    font-size: 11px;
    line-height: 12px;
    color: var(--white);
    white-space: nowrap;
  }
  .label.at-right { transform: translate(9px, -50%); }
  .label.at-left { transform: translate(calc(-100% - 9px), -50%); }
  .label.at-right-below { transform: translate(9px, 2px); }
  .label.at-right-above { transform: translate(9px, calc(-100% - 2px)); }
  .label.current {
    font-size: 13px;
    line-height: 14px;
    color: var(--flap-yellow);
    transform: translate(-50%, calc(-100% - 30px));
  }
  /* A city whose label normally sits below its pin keeps it below when current (Fairfax, clear of Toronto). */
  .label.current.at-right-below { transform: translate(-50%, 26px); }

  .plane {
    position: absolute;
    width: 49px;
    height: auto;
    transform-origin: 47.26% 48.3%;
    transform: translate(-47.26%, -48.3%) rotate(var(--rot, 0deg));
  }

  /* Slider bar */
  .hud {
    position: relative;
    height: 64px;
    border-top: 1px solid var(--sky-blue);
  }
  .track {
    position: absolute;
    inset: -1px 36px 0;
    cursor: pointer;
    touch-action: pan-y;
  }
  .track:focus-visible { outline-color: var(--sky-blue); outline-offset: 0; }
  .rail, .progress {
    position: absolute;
    left: 0;
    top: 33px;
    height: 2px;
  }
  .rail { right: 0; background: rgb(217 224 230 / 0.45); }
  .progress { top: 32.5px; height: 3px; background: var(--sky-blue); }
  .stop {
    position: absolute;
    top: 34px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
    border: 1.5px solid var(--silver-200);
    transform: translate(-50%, -50%);
  }
  .stop.reached { background: var(--sky-blue); border-color: var(--sky-blue); }
  .stop.current { width: 10px; height: 10px; background: var(--flap-yellow); border-color: var(--flap-yellow); }
  /* Bigger tap target than the dot */
  .stop::after {
    content: '';
    position: absolute;
    inset: -14px -10px -22px;
  }
  .code {
    position: absolute;
    top: 12.5px; /* 44px from the bar top, inside the 1.5px border */
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 13px;
    color: var(--silver-200);
  }
  .stop.current .code { top: 13.5px; font-weight: 700; color: var(--flap-yellow); }
  .thumb {
    position: absolute;
    top: 8.5px;
    width: 48px;
    height: auto;
    transform: translateX(-50%);
    pointer-events: none;
  }
</style>
