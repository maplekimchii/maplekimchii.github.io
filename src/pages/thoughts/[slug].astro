---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.summary}>
  <article class="container section post">
    <p><a class="text-link" href="/thoughts">← All thoughts</a></p>
    <header>
      <p class="mono-label">{post.data.code} · {post.data.topic} · {formatDate(post.data.date)}{post.data.readMinutes && ` · ${post.data.readMinutes} min`}</p>
      <h1 class="title">{post.data.title}</h1>
      <p class="summary">{post.data.summary}</p>
    </header>
    <div class="body"><Content /></div>
  </article>
</Base>

<style>
  .post { max-width: 820px; }
  .post > * + * { margin-top: 28px; }
  .title { margin-top: 10px; font-weight: 800; font-size: clamp(28px, 4vw, 44px); }
  .summary { margin-top: 12px; font-size: 18px; color: var(--muted); }
  .body :global(p + p) { margin-top: 1em; }
</style>
