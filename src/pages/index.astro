---
// Single-page site: Figma "home — simplified" (2060:941) and "(mobile)" (2104:2162).
import Base from '../layouts/Base.astro';
import SplitFlap from '../components/SplitFlap.astro';
import Row from '../components/Row.astro';
import JourneyMap from '../components/JourneyMap.astro';
import BaggageCarousel from '../components/BaggageCarousel.astro';
import { formatDate, formatRange, getCities, getExperience, getPosts, getProjects, profile } from '../lib/content';

const projects = await getProjects();
const experience = await getExperience();
const work = experience.filter((e) => e.data.type !== 'Student club');
const leadership = experience.filter((e) => e.data.type === 'Student club');
const posts = (await getPosts()).slice(0, 2);
const base = (await getCities()).at(-1)!;
const coord = (v: number, pos: string, neg: string) => `${Math.abs(v).toFixed(2)}° ${v >= 0 ? pos : neg}`;
const newTab = '(opens in a new tab)';

// Easter egg: highlighting the coordinates plays a random Drake preview (30s clips from Apple's
// public iTunes Search API; Spotify's preview API needs a login). Fetched at build time, so a
// failed fetch just leaves the egg out.
const songs = ['National Treasures', 'Hotline Bling', 'One Dance', 'Passionfruit', 'Headlines', 'Janice STFU', 'Nokia'];
type Track = { artistName: string; trackName: string; previewUrl?: string; artworkUrl100: string; trackViewUrl: string };
const drake = (
  await Promise.all(
    songs.map((song) =>
      fetch(`https://itunes.apple.com/search?term=${encodeURIComponent(`drake ${song}`)}&entity=song&limit=10&country=US`)
        .then((r) => r.json())
        .then((d: { results: Track[] }) => {
          const t = d.results.find((t) => t.artistName === 'Drake' && t.previewUrl && t.trackName.toLowerCase().startsWith(song.toLowerCase()));
          return t && { url: t.previewUrl!, title: t.trackName, art: t.artworkUrl100.replace('100x100', '160x160'), link: t.trackViewUrl };
        })
        .catch(() => undefined),
    ),
  )
).filter((t) => !!t);
---

<Base
  title={profile.name}
  description={`${profile.name}: ${profile.program} student at the ${profile.school}. ${profile.availability}.`}
>
  <section class="container hero" aria-labelledby="hero-name">
    <p class="kicker">Now departing · {base.data.city} ({base.id})</p>
    <h1 id="hero-name" class="visually-hidden">{profile.name}</h1>
    <SplitFlap rows={['SEAN', 'KIM ']} />
    <p class="headline">{profile.headline}</p>
    <div class="meta">
      <p class="coords" data-tracks={JSON.stringify(drake)}>{coord(base.data.lat, 'N', 'S')}, {coord(base.data.lon, 'E', 'W')}<span class="eq" aria-hidden="true"><i></i><i></i><i></i></span></p>
      <p class="status"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
    </div>
    <ul class="hero-links">
      <li><a href={`mailto:${profile.email}`}><span class="u">Email</span> <span class="arrow" aria-hidden="true">↗</span></a></li>
      <li><a href={profile.linkedin} target="_blank" rel="noopener"><span class="u">LinkedIn</span> <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> {newTab}</span></a></li>
      <li><a href={profile.github} target="_blank" rel="noopener"><span class="u">GitHub</span> <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> {newTab}</span></a></li>
      <li><a href={profile.resume} target="_blank" rel="noopener"><span class="u">Résumé (PDF)</span> <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> {newTab}</span></a></li>
    </ul>
  </section>

  <section id="work" class="container section" aria-labelledby="work-h">
    <h2 id="work-h" class="section-head"><span class="num">01</span>Selected work</h2>
    <ul class="rows">
      {projects.map((p) => (
        <li>
          <Row
            code={p.data.code}
            title={p.data.title}
            text={p.data.summary}
            tag={p.data.type}
            href={p.data.caseStudy ? `/projects/${p.id}` : undefined}
          />
        </li>
      ))}
    </ul>
  </section>

  <section id="experience" class="container section" aria-labelledby="exp-h">
    <h2 id="exp-h" class="section-head"><span class="num">02</span>Experience</h2>
    {[work, leadership].map((list, i) => (
      <>
        {i === 1 && <h3 class="sub-head">Leadership &amp; extracurricular</h3>}
        <ul class="rows">
          {list.map(({ data: e }) => (
            <li class="exp">
              <p class="when">{formatRange(e.start, e.end)}</p>
              <div class="what">
                <p class="role-line"><span class="role">{e.role}</span> <span class="org">{e.organisation}</span></p>
                <p class="tags">{e.tags.join(' · ')}</p>
              </div>
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>

  <section id="about" class="container section" aria-labelledby="about-h">
    <h2 id="about-h" class="section-head"><span class="num">03</span>About</h2>
    <div class="about-body">
      <div class="bio">
        {profile.bio.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
      </div>
      <JourneyMap />
    </div>
    <div class="carousel-block">
      <BaggageCarousel />
    </div>
  </section>

  {posts.length > 0 && (
    <section id="thoughts" class="container section" aria-labelledby="thoughts-h">
      <h2 id="thoughts-h" class="section-head"><span class="num">04</span>Thoughts</h2>
      <ul class="rows">
        {posts.map((p) => (
          <li>
            <Row
              code={p.data.code}
              title={p.data.title}
              text={`${formatDate(p.data.date)}${p.data.readMinutes ? ` · ${p.data.readMinutes} min read` : ''}`}
              tag={p.data.topic}
              href={`/thoughts/${p.id}`}
            />
          </li>
        ))}
      </ul>
      <p class="see-all"><a href="/thoughts">All thoughts →</a></p>
    </section>
  )}

  {drake.length > 0 && (
    <aside class="player" aria-label="Now playing" hidden>
      <img class="art" src="" alt="" width="48" height="48" />
      <div class="info">
        <p class="why">You highlighted {base.data.city.split(',')[0]}</p>
        <p class="song" aria-live="polite"></p>
        <p class="artist">Drake · preview</p>
        <span class="bar"><span class="fill"></span></span>
      </div>
      <a class="apple" href="" target="_blank" rel="noopener" aria-label="Open in Apple Music (opens in a new tab)">↗</a>
      <button class="stop" type="button" aria-label="Stop">×</button>
    </aside>
  )}
</Base>

<script>
  type Song = { url: string; title: string; art: string; link: string };
  const coords = document.querySelector<HTMLElement>('.coords');
  const player = document.querySelector<HTMLElement>('.player');
  const tracks: Song[] = JSON.parse(coords?.dataset.tracks ?? '[]');
  if (coords && player && tracks.length) {
    const audio = new Audio();
    audio.volume = 0.6;
    const fill = player.querySelector<HTMLElement>('.fill')!;
    let played = false; // one song per highlight
    let pending = false;

    const stop = () => {
      played = false;
      audio.pause();
      coords.classList.remove('playing');
      player.hidden = true;
    };
    const check = () => {
      const sel = getSelection();
      if (!sel || sel.isCollapsed || !sel.containsNode(coords, true)) return stop(); // highlight gone: stop right away
      if (played || pending) return;
      pending = true;
      const song = tracks[Math.floor(Math.random() * tracks.length)];
      audio.src = song.url;
      // Show the player straight away (the clip may take a moment to buffer).
      played = true;
      coords.classList.add('playing');
      player.querySelector<HTMLImageElement>('.art')!.src = song.art;
      player.querySelector('.song')!.textContent = song.title;
      player.querySelector<HTMLAnchorElement>('.apple')!.href = song.link;
      fill.style.width = '0%';
      player.hidden = false;
      // Some browsers only allow play() right after a tap or click: on refusal, undo so pointerup retries.
      audio
        .play()
        .catch((e: DOMException) => {
          if (e.name === 'NotAllowedError') stop();
        })
        .finally(() => (pending = false));
    };
    document.addEventListener('selectionchange', check);
    document.addEventListener('pointerup', () => setTimeout(check));
    audio.addEventListener('timeupdate', () => (fill.style.width = `${(audio.currentTime / (audio.duration || 30)) * 100}%`));
    audio.addEventListener('ended', () => getSelection()?.removeAllRanges());
    // Clicking the player must not clear the highlight (which would stop the song).
    player.addEventListener('mousedown', (e) => e.preventDefault());
    player.querySelector('.stop')!.addEventListener('click', () => getSelection()?.removeAllRanges());
  }
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    padding-block: 72px 140px;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .headline {
    max-width: 15.5em; /* breaks before "@ Waterloo", as in Figma */
    font-weight: 800;
    font-size: 64px;
    line-height: 1.05;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 40px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .status { display: flex; align-items: center; gap: 8px; color: var(--ink); }
  /* Easter egg: a flap-yellow highlight and dancing bars on the coordinates while a song plays */
  .coords.playing::selection { background: var(--flap-yellow); color: var(--ink); }
  .eq { display: none; align-items: flex-end; gap: 2px; height: 11px; margin-left: 8px; vertical-align: -1px; user-select: none; }
  .coords.playing .eq { display: inline-flex; }
  .eq i { width: 3px; height: 100%; background: var(--ink); transform-origin: bottom; animation: eq 700ms ease-in-out infinite alternate; }
  .eq i:nth-child(2) { animation-delay: -250ms; }
  .eq i:nth-child(3) { animation-delay: -500ms; }
  @keyframes eq { from { transform: scaleY(0.25); } to { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) { .eq i { animation: none; transform: scaleY(0.6); } }

  .player {
    position: fixed;
    left: 24px;
    bottom: 24px;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(320px, 100vw - 2 * var(--gutter));
    padding: 10px 12px 10px 10px;
    background: var(--ink);
    color: var(--white);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgb(14 42 82 / 0.25);
    animation: player-in 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .player[hidden] { display: none; }
  @keyframes player-in { from { opacity: 0; transform: translateY(12px); } }
  .player .art { flex: none; width: 48px; height: 48px; border-radius: 4px; background: var(--muted); }
  .player .info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; line-height: 1.2; }
  .why { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--flap-yellow); }
  .song { font-weight: 700; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .artist { font-size: 12px; color: var(--silver-200); }
  .bar { height: 3px; margin-top: 4px; border-radius: 2px; background: rgb(255 255 255 / 0.2); overflow: hidden; }
  .fill { display: block; width: 0; height: 100%; background: var(--flap-yellow); transition: width 250ms linear; }
  .apple, .stop {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: var(--white);
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
  }
  .apple:hover, .stop:hover { background: rgb(255 255 255 / 0.2); text-decoration: none; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--flap-yellow); }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }
  .hero-links a { font-weight: 500; font-size: 16px; color: var(--main-blue); }
  .hero-links a:hover { text-decoration: none; }
  .u { text-decoration: underline; text-underline-position: from-font; }
  .arrow { font-family: var(--font-mono); font-weight: 400; }

  /* Sections: "01  SELECTED WORK" head, then hairline-separated rows */
  .section { padding-block: 0 120px; }
  .section:last-child { padding-bottom: 64px; }
  .section > * + * { margin-top: 0; }
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 20px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    line-height: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .num { font-weight: 400; letter-spacing: 0; color: var(--muted); }
  .rows { border-top: 1px solid var(--silver-200); }
  .rows > li { border-bottom: 1px solid var(--silver-200); }

  .sub-head {
    padding: 56px 0 16px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    line-height: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .exp {
    display: flex;
    gap: 40px;
    padding-block: 24px;
    line-height: normal;
  }
  .when {
    flex: 0 0 200px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .what { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .role-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  .role { font-weight: 700; font-size: 20px; }
  .org { font-size: 16px; color: var(--muted); }
  .tags { font-family: var(--font-mono); font-size: 13px; color: var(--main-blue); }

  .about-body {
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 480px);
    justify-content: space-between;
    align-items: start;
    gap: 32px 80px;
    padding-top: 40px;
    border-top: 1px solid var(--silver-200);
  }
  .bio { display: flex; flex-direction: column; gap: 20px; font-size: 17px; line-height: 1.55; color: var(--muted); }
  .bio .lead { font-weight: 500; font-size: 24px; line-height: 1.4; color: var(--ink); }
  .carousel-block { padding-top: 64px; }

  .see-all { padding-top: 24px; }
  .see-all a { font-weight: 500; font-size: 16px; text-decoration: underline; text-underline-position: from-font; }

  @media (max-width: 1023px) {
    .about-body { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 767px) {
    .player { left: var(--gutter); bottom: 16px; }
    .hero { gap: 28px; padding-block: 40px 80px; }
    .headline { font-size: 36px; }
    .meta { flex-direction: column; align-items: flex-start; }
    .hero-links { gap: 12px 20px; }
    .section { padding-bottom: 80px; }
    .section:last-child { padding-bottom: 40px; }
    .exp { flex-direction: column; gap: 8px; padding-block: 18px; }
    .when { flex-basis: auto; }
    .sub-head { padding-top: 40px; }
    .about-body { padding-top: 28px; }
    .bio .lead { font-size: 20px; }
    .bio { font-size: 16px; }
    .carousel-block { padding-top: 48px; }
  }
</style>
