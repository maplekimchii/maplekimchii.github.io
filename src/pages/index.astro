---
// Single-page site: Figma "home — simplified" (2060:941) and "(mobile)" (2104:2162).
import Base from '../layouts/Base.astro';
import SplitFlap from '../components/SplitFlap.astro';
import Row from '../components/Row.astro';
import JourneyMap from '../components/JourneyMap.astro';
import BaggageCarousel from '../components/BaggageCarousel.astro';
import { formatDate, formatRange, getCities, getExperience, getPosts, getProjects, profile } from '../lib/content';

const projects = await getProjects();
const experience = await getExperience();
const work = experience.filter((e) => e.data.type !== 'Student club');
const leadership = experience.filter((e) => e.data.type === 'Student club');
const posts = (await getPosts()).slice(0, 2);
const base = (await getCities()).at(-1)!;
const coord = (v: number, pos: string, neg: string) => `${Math.abs(v).toFixed(2)}° ${v >= 0 ? pos : neg}`;
const newTab = '(opens in a new tab)';
---

<Base
  title={profile.name}
  description={`${profile.name}: ${profile.program} student at the ${profile.school}. ${profile.availability}.`}
>
  <section class="container hero" aria-labelledby="hero-name">
    <p class="kicker">Now departing · {base.data.city} ({base.id})</p>
    <h1 id="hero-name" class="visually-hidden">{profile.name}</h1>
    <SplitFlap rows={['SEAN', 'KIM ']} />
    <p class="headline">{profile.headline}</p>
    <div class="meta">
      <p>{coord(base.data.lat, 'N', 'S')}, {coord(base.data.lon, 'E', 'W')}</p>
      <p class="status"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
    </div>
    <ul class="hero-links">
      <li><a href={`mailto:${profile.email}`}><span class="u">Email</span> <span class="arrow" aria-hidden="true">↗</span></a></li>
      <li><a href={profile.linkedin} target="_blank" rel="noopener"><span class="u">LinkedIn</span> <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> {newTab}</span></a></li>
      <li><a href={profile.github} target="_blank" rel="noopener"><span class="u">GitHub</span> <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> {newTab}</span></a></li>
      <li><a href={profile.resume} target="_blank" rel="noopener"><span class="u">Résumé (PDF)</span> <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> {newTab}</span></a></li>
    </ul>
  </section>

  <section id="work" class="container section" aria-labelledby="work-h">
    <h2 id="work-h" class="section-head"><span class="num">01</span>Selected work</h2>
    <ul class="rows">
      {projects.map((p) => (
        <li>
          <Row
            code={p.data.code}
            title={p.data.title}
            text={p.data.summary}
            tag={p.data.type}
            href={p.data.caseStudy ? `/projects/${p.id}` : undefined}
          />
        </li>
      ))}
    </ul>
  </section>

  <section id="experience" class="container section" aria-labelledby="exp-h">
    <h2 id="exp-h" class="section-head"><span class="num">02</span>Experience</h2>
    {[work, leadership].map((list, i) => (
      <>
        {i === 1 && <h3 class="sub-head">Leadership &amp; extracurricular</h3>}
        <ul class="rows">
          {list.map(({ data: e }) => (
            <li class="exp">
              <p class="when">{formatRange(e.start, e.end)}</p>
              <div class="what">
                <p class="role-line"><span class="role">{e.role}</span> <span class="org">{e.organisation}</span></p>
                <p class="tags">{e.tags.join(' · ')}</p>
              </div>
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>

  <section id="about" class="container section" aria-labelledby="about-h">
    <h2 id="about-h" class="section-head"><span class="num">03</span>About</h2>
    <div class="about-body">
      <div class="bio">
        {profile.bio.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
      </div>
      <JourneyMap />
    </div>
    <div class="carousel-block">
      <BaggageCarousel />
    </div>
  </section>

  {posts.length > 0 && (
    <section id="thoughts" class="container section" aria-labelledby="thoughts-h">
      <h2 id="thoughts-h" class="section-head"><span class="num">04</span>Thoughts</h2>
      <ul class="rows">
        {posts.map((p) => (
          <li>
            <Row
              code={p.data.code}
              title={p.data.title}
              text={`${formatDate(p.data.date)}${p.data.readMinutes ? ` · ${p.data.readMinutes} min read` : ''}`}
              tag={p.data.topic}
              href={`/thoughts/${p.id}`}
            />
          </li>
        ))}
      </ul>
      <p class="see-all"><a href="/thoughts">All thoughts →</a></p>
    </section>
  )}
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    padding-block: 72px 140px;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .headline {
    max-width: 15.5em; /* breaks before "@ Waterloo", as in Figma */
    font-weight: 800;
    font-size: 64px;
    line-height: 1.05;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 40px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .status { display: flex; align-items: center; gap: 8px; color: var(--ink); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--flap-yellow); }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }
  .hero-links a { font-weight: 500; font-size: 16px; color: var(--main-blue); }
  .hero-links a:hover { text-decoration: none; }
  .u { text-decoration: underline; text-underline-position: from-font; }
  .arrow { font-family: var(--font-mono); font-weight: 400; }

  /* Sections: "01  SELECTED WORK" head, then hairline-separated rows */
  .section { padding-block: 0 120px; }
  .section > * + * { margin-top: 0; }
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 20px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    line-height: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .num { font-weight: 400; letter-spacing: 0; color: var(--muted); }
  .rows { border-top: 1px solid var(--silver-200); }
  .rows > li { border-bottom: 1px solid var(--silver-200); }

  .sub-head {
    padding: 56px 0 16px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    line-height: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .exp {
    display: flex;
    gap: 40px;
    padding-block: 24px;
    line-height: normal;
  }
  .when {
    flex: 0 0 200px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .what { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .role-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  .role { font-weight: 700; font-size: 20px; }
  .org { font-size: 16px; color: var(--muted); }
  .tags { font-family: var(--font-mono); font-size: 13px; color: var(--main-blue); }

  .about-body {
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 480px);
    justify-content: space-between;
    align-items: start;
    gap: 32px 80px;
    padding-top: 40px;
    border-top: 1px solid var(--silver-200);
  }
  .bio { display: flex; flex-direction: column; gap: 20px; font-size: 17px; line-height: 1.55; color: var(--muted); }
  .bio .lead { font-weight: 500; font-size: 24px; line-height: 1.4; color: var(--ink); }
  .carousel-block { padding-top: 64px; }

  .see-all { padding-top: 24px; }
  .see-all a { font-weight: 500; font-size: 16px; text-decoration: underline; text-underline-position: from-font; }

  @media (max-width: 1023px) {
    .about-body { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 767px) {
    .hero { gap: 28px; padding-block: 40px 80px; }
    .headline { font-size: 36px; }
    .meta { flex-direction: column; align-items: flex-start; }
    .hero-links { gap: 12px 20px; }
    .section { padding-bottom: 80px; }
    .exp { flex-direction: column; gap: 8px; padding-block: 18px; }
    .when { flex-basis: auto; }
    .sub-head { padding-top: 40px; }
    .about-body { padding-top: 28px; }
    .bio .lead { font-size: 20px; }
    .bio { font-size: 16px; }
    .carousel-block { padding-top: 48px; }
  }
</style>
