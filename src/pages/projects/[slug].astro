---
import Base from '../../layouts/Base.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.filter((p) => p.data.caseStudy).map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const p = project.data;
const cs = p.caseStudy!;
---

<Base title={p.title} description={p.summary}>
  <article class="container section case">
    <p class="crumb"><a class="text-link" href="/#work">← All projects</a></p>
    <header class="card head">
      <div class="strip"><span class="code">{p.code}</span><span>{p.type}</span></div>
      <div class="head-body">
        <h1 class="title">{p.title}</h1>
        <p class="summary">{p.summary}</p>
        <dl class="meta">
          <div><dt class="mono-label">Role</dt><dd>{p.role}</dd></div>
          {p.year && <div><dt class="mono-label">Timeline</dt><dd>{p.year}</dd></div>}
          <div><dt class="mono-label">Stack</dt><dd>{p.stack.join(' · ')}</dd></div>
        </dl>
      </div>
    </header>

    <section aria-labelledby="problem-h">
      <SectionDivider title="Problem" id="problem-h" />
      <p class="prose">{cs.problem}</p>
    </section>
    <section aria-labelledby="did-h">
      <SectionDivider title="What I did" id="did-h" />
      <ul class="list">{cs.whatIDid.map((x) => <li>{x}</li>)}</ul>
    </section>
    <section aria-labelledby="outcome-h">
      <SectionDivider title="Outcome" id="outcome-h" />
      <ul class="list">{cs.outcome.map((x) => <li>{x}</li>)}</ul>
    </section>
    {p.links.length > 0 && (
      <section aria-labelledby="links-h">
        <SectionDivider title="Links" id="links-h" />
        <p class="links">
          {p.links.map((l) => (
            <a class="text-link" href={l.href} target="_blank" rel="noopener">{l.label} ↗<span class="visually-hidden"> (opens in a new tab)</span></a>
          ))}
        </p>
      </section>
    )}
  </article>
</Base>

<style>
  .case { display: flex; flex-direction: column; gap: 40px; }
  .case section { display: flex; flex-direction: column; gap: 20px; }
  .head { overflow: hidden; }
  .strip {
    display: flex;
    justify-content: space-between;
    padding: 10px 16px;
    background: var(--sky-blue);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
  }
  .code { font-weight: 700; letter-spacing: 0.06em; }
  .head-body { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .title { font-weight: 800; font-size: clamp(28px, 4vw, 44px); }
  .summary { font-size: 18px; color: var(--muted); max-width: 70ch; }
  .meta { display: flex; flex-wrap: wrap; gap: 16px 40px; }
  .meta div { display: flex; flex-direction: column; gap: 4px; }
  .meta dd { font-weight: 700; font-size: 15px; }
  .prose { font-size: 16px; max-width: 70ch; }
  .list { display: flex; flex-direction: column; gap: 10px; max-width: 75ch; }
  .list li { position: relative; padding-left: 26px; }
  .list li::before { content: '→'; position: absolute; left: 0; color: var(--main-blue); font-family: var(--font-mono); }
  .links { display: flex; gap: 24px; }
</style>
